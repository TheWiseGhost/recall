# Copy to .env and fill in. .env is git-ignored; .env.example is not.

DATABASE_URL=postgresql+asyncpg://recall:recall@localhost:5432/recall
REDIS_URL=redis://localhost:6379/0

# Compose overrides (optional)
# POSTGRES_USER=recall
# POSTGRES_PASSWORD=recall
# POSTGRES_DB=recall
# POSTGRES_PORT=5432

# Only needed when embedding.provider is openai.
# OPENAI_API_KEY=

# Only needed for the GitHub / Notion connectors (Milestone 4).
# GITHUB_TOKEN=
# NOTION_API_KEY=
